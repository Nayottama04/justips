rules_version = '2';
// MOCK TUGAS KULIAH: aturan longgar (semua pengguna login boleh baca/tulis).
// Untuk produksi: pindahkan escrow/saldo/pencairan ke Cloud Functions dan
// batasi write per koleksi (mis. hanya pemilik yang boleh ubah users/{uid}).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
